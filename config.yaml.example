# ─── API ──────────────────────────────────────────────────────────────────────
provider: claude # openai | gemini | claude
model: claude-opus-4-6
reasoning: none  # none | low | medium | high

# Model IDs per provider:
#   openai:  gpt-5.2
#   gemini:  gemini-3.1-pro-preview
#   claude:  claude-opus-4-6

# Provider API keys (set via env var or paste directly)
api_key: ""  # OpenAI  — or set OPENAI_API_KEY env var
google_api_key: ""  # Gemini  — or set GOOGLE_API_KEY env var
anthropic_api_key: ""  # Claude  — or set ANTHROPIC_API_KEY env var

# ─── Record Building ─────────────────────────────────────────────────────────
sampling_step: 8       # frames between T=0 samples (at 2Hz: 8 = 4s)
history_frames: 3      # frames before T=0 needed (1.5s at 2Hz)
future_frames: 8       # frames after T=0 needed (4s at 2Hz)

# ─── Batch Processing ─────────────────────────────────────────────────────────
batch:
  enabled: false  # Set to true to use batch API instead of real-time
  batch_dir: batch_jobs  # Directory for batch request files
  results_dir: batch_results  # Directory for batch results
  monitor_interval: 30  # Seconds between status checks
  max_scenes_per_batch: 1000  # Maximum scenes per batch file
  completion_window: 24h  # Batch completion window (24h default)
  prompt_version: v5  # Prompt version for QA generation

# ─── nuScenes ────────────────────────────────────────────────────────────────
nuscenes:
  dataroot: /path/to/nuscenes
  version: v1.0-trainval
  maps: /path/to/nuscenes/maps/expansion
  records: /path/to/records/nuscenes_v1
  outputs: /path/to/outputs/nuscenes_v1
  num_scenes: 200

# ─── OpenScene (NAVSIM) ──────────────────────────────────────────────────────
openscene:
  logs: /path/to/navsim_logs/trainval
  blobs: /path/to/sensor_blobs/trainval
  maps: /path/to/navsim/maps
  records: /path/to/records/openscene
  outputs: /path/to/outputs/openscene
  num_scenes: 10

# ─── Argoverse V2 ────────────────────────────────────────────────────────────
argoverse2:
  data: /path/to/argoverse2/sensor/val
  records: /path/to/records/argoverse2
  outputs: /path/to/outputs/argoverse2
  num_scenes: 10
