# =====================================================================
# Environment variables for Doe-1 evaluation
# Copy to dev.env and fill in your values before running.
# Never commit the filled-in dev.env to source control.
#
# NOTE: Doe-1 weights are NOT on HuggingFace.
# Download from Tsinghua Cloud: https://cloud.tsinghua.edu.cn/d/86e47c05830e4caaa40e/
# VQVAE weights from Facebook Chameleon: https://github.com/facebookresearch/chameleon
# (place under WEIGHTS_DIR/chameleon/tokenizer/)
# =====================================================================

# ---- Model weights (Tsinghua Cloud — manual download required) ------
# HF_TOKEN is not needed for Doe-1 weights, but may be used for
# downloading base models (e.g. nuScenes annotations via OmniDrive HF).
HF_TOKEN=

WEIGHTS_DIR=./weights
WEIGHTS_PATH=/workspace/weights

# Path to the Doe-1 model checkpoint (downloaded from Tsinghua Cloud)
MODEL_CHECKPOINT=/workspace/weights/doe1/model.pth

# Path to Chameleon VQVAE tokenizer (from facebookresearch/chameleon)
VQVAE_PATH=/workspace/weights/chameleon/tokenizer

# ---- Dataset mounts -------------------------------------------------
RAW_DATA_DIR=/raw_data
CAUSAL_BENCH_DIR=/causal_drive_bench/causal_nuscenes

# ---- OmniDrive annotation files (needed for nuScenes QA) -----------
# Download from: https://github.com/NVlabs/OmniDrive/releases/tag/v1.0
ANNO_PATH=/raw_data/nuscenes/val_infos.pkl

# ---- Output directory -----------------------------------------------
OUTPUT_DIR=./outputs

# ---- Inference settings ---------------------------------------------
BATCH_SIZE=1
DEVICE=cuda
NUM_WORKERS=2

# ---- LLM Judge (for open-ended QA) ----------------------------------
OPENAI_API_KEY=
JUDGE_MODEL=gpt-4o
