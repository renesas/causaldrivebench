# =====================================================================
# Environment variables for ReCogDrive evaluation
# Copy to dev.env and fill in your values before running.
# Never commit the filled-in dev.env to source control.
# =====================================================================

# ---- HuggingFace credentials ----------------------------------------
# Only required for gated repos. ReCogDrive-VLM-8B is public (no token needed).
HF_TOKEN=

# ---- Model repo (HuggingFace model ID) ------------------------------
# Use the VLM variant for VQA evaluation (not the diffusion planner variants):
#   owl10/ReCogDrive-VLM-8B  (recommended — 8B, fine-tuned on driving data)
#   owl10/ReCogDrive-VLM-2B  (2B, lower memory)
MODEL_REPO=owl10/ReCogDrive-VLM-8B

# ---- Weights mount (host path) --------------------------------------
# Downloaded weights will be stored/cached here.
WEIGHTS_DIR=

# ---- Dataset mounts -------------------------------------------------
# Host path to the original open-source datasets and preprocessing outputs.
# Mounted read-only at /workspace/data/raw_data inside the container.
RAW_DATA_DIR=

# Host path to the causal_drive_bench parent directory (contains causal_nuscenes/, etc.).
# Mounted read-only at /workspace/data/causal_drive_bench inside the container.
CAUSAL_BENCH_DIR=

# ---- Output directories ---------------------------------------------
# Mounted read-write at /workspace/data/cdb_outputs inside the container.
CDB_OUTPUTS_DIR=

# Mounted read-write at /workspace/data/cdb_reports inside the container.
CDB_REPORTS_DIR=

# ---- Inference settings ---------------------------------------------
DEVICE=cuda

# ---- LLM Judge (postprocess --use-llm-judge) ------------------------
USE_LLM_JUDGE=false
JUDGE_PROVIDER=azure_foundry
JUDGE_MODEL=claude-opus-4-6
ANTHROPIC_FOUNDRY_API_KEY=
FOUNDRY_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
