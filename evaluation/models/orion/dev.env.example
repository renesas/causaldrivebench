# =====================================================================
# Environment variables for Orion evaluation
# Copy to dev.env and fill in your values before running.
# Never commit the filled-in dev.env to source control.
# =====================================================================

# ---- Model weights (HuggingFace) ------------------------------------
HF_TOKEN=
MODEL_REPO=poleyzdk/Orion
WEIGHTS_DIR=./weights
WEIGHTS_PATH=/workspace/weights

# Path to the Orion checkpoint inside the container
MODEL_CHECKPOINT=/workspace/weights/Orion.pth

# Additional weights needed (place under WEIGHTS_DIR):
#   pretrain_qformer:  https://huggingface.co/exiawsh/pretrain_qformer
#   EVA proj weights:  https://github.com/NVlabs/OmniDrive/releases/tag/v1.0 (eva02_petr_proj.pth)
PRETRAIN_QFORMER_PATH=/workspace/weights/pretrain_qformer
EVA_PROJ_PATH=/workspace/weights/eva02_petr_proj.pth

# Path to inference config inside the container (FP32 / FP16 / CoT)
MODEL_CONFIG=/workspace/model/adzoo/orion/configs/orion_stage3_fp16.py

# ---- Dataset mounts -------------------------------------------------
RAW_DATA_DIR=/raw_data
CAUSAL_BENCH_DIR=/causal_drive_bench/causal_nuscenes

# ---- Output directory -----------------------------------------------
OUTPUT_DIR=./outputs

# ---- Inference settings ---------------------------------------------
# Orion FP32 requires 32 GB GPU; use fp16 config for 17 GB GPUs
BATCH_SIZE=1
DEVICE=cuda
NUM_WORKERS=2

# ---- LLM Judge (for open-ended QA) ----------------------------------
OPENAI_API_KEY=
JUDGE_MODEL=gpt-4o
