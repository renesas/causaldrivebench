# =====================================================================
# SafeAuto dev environment — copy to dev.env and fill in your values.
# Never commit dev.env to source control.
# =====================================================================

# Checkpoint path (already downloaded)
WEIGHTS_PATH=/workspace/ckpts/SafeAuto-DriveLM

# Dataset bench directory
CAUSAL_BENCH_DIR=/workspace/neurips-dataset/evaluation/sample_data/causal_nuscenes

# Output directory for inference runs
OUTPUT_DIR=/workspace/neurips-dataset/evaluation/sample_outputs

# Inference settings
BATCH_SIZE=1
DEVICE=cuda
DATASET=nuscenes

# Run mode: full | subset | single
MODE=single
SCENE=nuscenes-scene-0159

# LLM Judge (optional — leave blank to skip)
OPENAI_API_KEY=
JUDGE_MODEL=gpt-4o
