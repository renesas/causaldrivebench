# =====================================================================
# Environment variables for OpenDriveVLA evaluation
# Copy to dev.env and fill in your values before running.
# Never commit the filled-in dev.env to source control.
# =====================================================================

# ---- Model weights (HuggingFace) ------------------------------------
HF_TOKEN=
MODEL_REPO=OpenDriveVLA/OpenDriveVLA-0.5B
WEIGHTS_DIR=./weights
WEIGHTS_PATH=/workspace/weights

# Path to checkpoint inside the container
MODEL_CHECKPOINT=/workspace/weights/OpenDriveVLA-0.5B

# ---- Dataset mounts -------------------------------------------------
RAW_DATA_DIR=/raw_data
CAUSAL_BENCH_DIR=/causal_drive_bench/causal_nuscenes

# ---- Output directory -----------------------------------------------
OUTPUT_DIR=./outputs

# ---- Inference settings ---------------------------------------------
BATCH_SIZE=1
DEVICE=cuda
NUM_WORKERS=2
# Precision: bf16 | fp16 | fp32
PRECISION=bf16

# ---- LLM Judge (for open-ended QA) ----------------------------------
OPENAI_API_KEY=
JUDGE_MODEL=gpt-4o
