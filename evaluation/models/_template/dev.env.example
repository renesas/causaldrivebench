# =====================================================================
# Environment variables for local development / Docker run
# Copy to dev.env and fill in your values before running.
# Never commit the filled-in dev.env file to source control.
# =====================================================================

# ---- Model weights --------------------------------------------------
# For HuggingFace-hosted models:
HF_TOKEN=
MODEL_REPO=
# Host path where weights will be downloaded and mounted read-write:
WEIGHTS_DIR=./weights
# Container-internal path (must match docker-compose volumes target):
WEIGHTS_PATH=/workspace/weights

# ---- Dataset mounts -------------------------------------------------
# Host path to the original open-source datasets and preprocessing outputs.
# Mounted read-only at /raw_data inside the container.
RAW_DATA_DIR=/raw_data

# Host path to the dataset-specific causal bench directory.
# Mounted read-only at /causal_drive_bench inside the container.
# Set to the appropriate subdirectory for the dataset being evaluated,
# e.g. /causal_drive_bench/causal_nuscenes or /causal_drive_bench/causal_argoverse2.
CAUSAL_BENCH_DIR=/causal_drive_bench/causal_nuscenes

# ---- Output directory -----------------------------------------------
OUTPUT_DIR=/outputs

# ---- Inference settings ---------------------------------------------
BATCH_SIZE=4
DEVICE=cuda
NUM_WORKERS=2

# ---- LLM Judge (for open-ended QA) ----------------------------------
OPENAI_API_KEY=
JUDGE_MODEL=gpt-4o
