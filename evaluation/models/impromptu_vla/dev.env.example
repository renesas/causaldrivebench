# =====================================================================
# Environment variables for Impromptu-VLA evaluation
# Copy to dev.env and fill in your values before running.
# Never commit the filled-in dev.env to source control.
# =====================================================================

# ---- Model weights (HuggingFace) ------------------------------------
HF_TOKEN=
# Choose one variant: 3B or 7B; Base, AD, or AD_finetune
# Available repos (all under aaaaaap/ImpromptuVLAModel):
#   3B_Base_finetune | 3B_AD | 3B_AD_finetune
#   7B_Base_finetune | 7B_AD | 7B_AD_finetune
MODEL_REPO=aaaaaap/ImpromptuVLAModel
MODEL_VARIANT=3B_AD_finetune

WEIGHTS_DIR=./weights
WEIGHTS_PATH=/workspace/weights

# Full path to the downloaded model checkpoint directory
MODEL_CHECKPOINT=/workspace/weights/ImpromptuVLAModel/3B_AD_finetune

# ---- Dataset mounts -------------------------------------------------
RAW_DATA_DIR=/raw_data
CAUSAL_BENCH_DIR=/causal_drive_bench/causal_nuscenes

# ---- Output directory -----------------------------------------------
OUTPUT_DIR=./outputs

# ---- Inference settings (sglang) ------------------------------------
BATCH_SIZE=1
DEVICE=cuda
NUM_WORKERS=2
# sglang tensor/data parallelism
TENSOR_PARALLEL_SIZE=1
DATA_PARALLEL_SIZE=1
# Prompt template (Qwen2.5-VL family)
TEMPLATE=qwen2_vl

# ---- LLM Judge (for open-ended QA) ----------------------------------
OPENAI_API_KEY=
JUDGE_MODEL=gpt-4o
