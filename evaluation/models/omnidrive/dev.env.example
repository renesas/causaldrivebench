# =====================================================================
# Environment variables for OmniDrive evaluation
# Copy to dev.env and fill in your values before running.
# Never commit the filled-in dev.env to source control.
# =====================================================================

# ---- HuggingFace credentials ----------------------------------------
# Required if downloading weights from a gated HF repo.
HF_TOKEN=

# ---- Model repo (path to the cloned OmniDrive repository) -----------
# inference.py will os.chdir() here so relative config paths resolve
# (e.g. ckpts/tiny_llama/, ckpts/eva02_petr_proj.pth).
MODEL_REPO=/workspace/OmniDrive

# ---- Weights mount (host path) --------------------------------------
# Model weights directory (checkpoint + vision encoder weights).
WEIGHTS_DIR=

# ---- Model config and checkpoint ------------------------------------
# Full path to the mmdet3d config file inside the OmniDrive repo.
MODEL_CONFIG=/workspace/OmniDrive/projects/configs/OmniDrive/eva_base_tinyllama.py

# Full path to the OmniDrive checkpoint (.pth).
MODEL_CHECKPOINT=/workspace/OmniDrive/ckpts/iter_10548.pth

# ---- Dataset mounts -------------------------------------------------
# Host path to the original open-source datasets and preprocessing outputs.
# Mounted read-only at /workspace/data/raw_data inside the container.
RAW_DATA_DIR=

# Host path to the causal_drive_bench parent directory (contains causal_nuscenes/, etc.).
# Mounted read-only at /workspace/data/causal_drive_bench inside the container.
CAUSAL_BENCH_DIR=

# ---- Output directories ---------------------------------------------
# Mounted read-write at /workspace/data/cdb_outputs inside the container.
CDB_OUTPUTS_DIR=

# Mounted read-write at /workspace/data/cdb_reports inside the container.
CDB_REPORTS_DIR=

# ---- Inference settings ---------------------------------------------
DEVICE=cuda

# ---- LLM Judge (postprocess --use-llm-judge) ------------------------
# Set USE_LLM_JUDGE=true to score chain-of-causation reasoning quality
# after inference.  Requires a supported provider API key below.
USE_LLM_JUDGE=false

# Provider: azure_foundry (Claude on Azure) | azure_openai (GPT on Azure)
#           anthropic (direct)              | openai (direct)
JUDGE_PROVIDER=azure_foundry

# Deployment/model name (set to your Azure deployment name for Azure providers)
JUDGE_MODEL=claude-opus-4-6

# -- Azure AI Foundry (Claude) ----------------------------------------
# Endpoint format: https://<resource-name>.services.ai.azure.com/anthropic
ANTHROPIC_FOUNDRY_API_KEY=
FOUNDRY_BASE_URL=

# -- Azure OpenAI Service (GPT) ----------------------------------------
# Endpoint format: https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# -- Direct Anthropic / OpenAI (non-Azure) ----------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
