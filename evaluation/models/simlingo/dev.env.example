# =====================================================================
# Environment variables for SimLingo evaluation
# Copy to dev.env and fill in your values before running.
# Never commit the filled-in dev.env to source control.
#
# NOTE: SimLingo's closed-loop evaluation requires CARLA 0.9.15.
# This setup targets language-model inference only (no CARLA needed).
# =====================================================================

# ---- Model weights (HuggingFace) ------------------------------------
HF_TOKEN=
MODEL_REPO=RenzKa/simlingo
WEIGHTS_DIR=./weights
WEIGHTS_PATH=/workspace/weights

# Vision backbone (downloaded automatically by transformers)
VISION_MODEL=OpenGVLab/InternVL2-1B

# ---- Dataset mounts -------------------------------------------------
RAW_DATA_DIR=/raw_data
CAUSAL_BENCH_DIR=/causal_drive_bench/causal_nuscenes

# ---- Output directory -----------------------------------------------
OUTPUT_DIR=./outputs

# ---- Inference settings ---------------------------------------------
BATCH_SIZE=1
DEVICE=cuda
NUM_WORKERS=2

# ---- LLM Judge (for open-ended QA) ----------------------------------
OPENAI_API_KEY=
JUDGE_MODEL=gpt-4o
