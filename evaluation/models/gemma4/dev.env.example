# =====================================================================
# Environment variables for Gemma 4 evaluation
# Copy to dev.env and fill in your values before running.
# Never commit the filled-in dev.env to source control.
#
# Gemma 4 model weights are shipped inside the ai/gemma4 Docker image —
# no HuggingFace token is required.
# =====================================================================

# ---- Model variant selection ----------------------------------------
# Choose which Gemma 4 model size to run.
# Available tags: e2b | e4b | 26b-a4b | 31b
#
#   e2b     — 2.3B effective params (5.1B w/ embeddings), 128K ctx, Text+Image+Audio
#   e4b     — 4.5B effective params (8B w/ embeddings),  128K ctx, Text+Image+Audio
#   26b-a4b — 25.2B total / 3.8B active MoE,            256K ctx, Text+Image
#   31b     — 30.7B dense,                               256K ctx, Text+Image
#
# Each variant produces a separate run directory (gemma4_<tag>_<timestamp>).
GEMMA4_MODEL_TAG=e2b

# ---- Model server endpoint ------------------------------------------
# URL of the Gemma 4 OpenAI-compatible API, as seen from the inference container.
#
# Option A — Docker model runner / ai/gemma4 compose service (n_parallel ≈ 4):
#   GEMMA4_API_BASE_URL=http://gemma4-server:8080/v1
#   GEMMA4_API_MODEL_NAME=ai/gemma4:${GEMMA4_MODEL_TAG}
#   CONCURRENT_REQUESTS=4
#
# Option B — Direct llama.cpp server via setup.sh (--parallel 64, recommended):
#   bash evaluation/models/gemma4/setup.sh   # starts llamacpp-gemma4 on port 8080
#   GEMMA4_API_BASE_URL=http://localhost:8080/v1
#   GEMMA4_API_MODEL_NAME=model.gguf         # llama.cpp reports the GGUF filename
#   CONCURRENT_REQUESTS=64                   # must match --parallel N
GEMMA4_API_BASE_URL=http://gemma4-server:8080/v1
GEMMA4_API_MODEL_NAME=ai/gemma4:${GEMMA4_MODEL_TAG}

# Host port to expose the model server on (used by docker-compose).
GEMMA4_PORT=8080

# ---- Dataset mounts -------------------------------------------------
# Host path to the original open-source datasets.
# Mounted read-only at /workspace/data/raw_data inside the container.
RAW_DATA_DIR=

# Host path to the causal_drive_bench parent directory (contains causal_nuscenes/, etc.).
# Mounted read-only at /workspace/data/causal_drive_bench inside the container.
CAUSAL_BENCH_DIR=

# ---- Output directories ---------------------------------------------
# Mounted read-write at /workspace/data/cdb_outputs inside the container.
CDB_OUTPUTS_DIR=

# Mounted read-write at /workspace/data/cdb_reports inside the container.
CDB_REPORTS_DIR=

# ---- High-throughput server settings (llama.cpp direct, setup.sh) ---
# Used by setup.sh and the docker-compose llamacpp-server service.
# WEIGHTS_DIR must contain GGUF_FILE and MMPROJ_FILE.
WEIGHTS_DIR=/datadrive/models/gemma4
GGUF_FILE=gemma-4-e4b-it-Q4_K_M.gguf
MMPROJ_FILE=gemma-4-e4b-it.mmproj

# Parallelism: PARALLEL_SLOTS controls --parallel N on the server.
# CTX_SIZE = PARALLEL_SLOTS × CTX_PER_SLOT (10240 tokens/slot default).
# VRAM at --parallel 64 (Gemma4 E4B, SWA arch): ~18 GB on A100 80 GB.
PARALLEL_SLOTS=64
CTX_PER_SLOT=10240
CTX_SIZE=655360

# ---- Inference settings ---------------------------------------------
# Max tokens the model should generate per answer.
# Use 512 for quick tests, 10000 for full CoT evaluation.
MAX_TOKENS=512

# Image resolution for vision API requests (resize before encoding).
# Higher = more detail but more tokens consumed per image.
# Recommended: 448 (balanced) or 224 (faster / lower-VRAM models).
IMAGE_SIZE=448

# GPU utilization: set CONCURRENT_REQUESTS to match server --parallel N.
# With Docker model runner (Option A): 4
# With direct llama.cpp setup.sh (Option B): 64
CONCURRENT_REQUESTS=4

# Image preload: pre-encodes all dataset images into RAM before inference.
# Eliminates per-question disk I/O. ~2.1 GB RAM, ~60s startup.
# Recommended for full-dataset runs.
PRELOAD_IMAGES=false
PRELOAD_WORKERS=64

# Persistent image cache (cross-model, survives restarts).
# Build once with: python evaluation/build_image_cache.py --bench-dir ... --cache-dir /datadrive/cache/image_base64
# Then set this var to load the cache in ~2s instead of ~60s re-encoding.
PERSISTENT_IMAGE_CACHE=

# Prompt generation: pre-generates all prompts.jsonl in parallel before inference.
PROMPT_GEN_WORKERS=64

# Sample-level concurrency: process N samples in parallel.
# K samples × ~10 questions/sample = ~10K questions in flight simultaneously.
# Match to server --parallel N: SAMPLE_CONCURRENCY ≈ N / avg_questions_per_sample
# Example: --parallel 64, ~10 q/sample → SAMPLE_CONCURRENCY=6
#          --parallel 192, ~10 q/sample → SAMPLE_CONCURRENCY=19
SAMPLE_CONCURRENCY=1

# ---- Monitoring (monitor.sh / milestone_watch.sh) -------------------
# Total number of QA samples expected (used for percentage display).
# If unset, auto-detected from CAUSAL_BENCH_DIR/manifest.json.
TOTAL_SAMPLES=

# How often milestone_watch.sh checks for new completions (seconds).
CHECK_INTERVAL=120

# ---- LLM Judge (postprocess --use-llm-judge) ------------------------
USE_LLM_JUDGE=false

# Provider: azure_foundry | azure_openai | anthropic | openai
JUDGE_PROVIDER=azure_foundry
JUDGE_MODEL=claude-opus-4-6

# -- Azure AI Foundry (Claude) ----------------------------------------
ANTHROPIC_FOUNDRY_API_KEY=
FOUNDRY_BASE_URL=

# -- Azure OpenAI Service (GPT) ----------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# -- Direct Anthropic / OpenAI (non-Azure) ----------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
